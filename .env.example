# Copy to .env and fill in the required values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change_me
JWT_SECRET=replace_with_64_plus_char_base64_string_here_AAAAAAAAAAAAAAAAAAA=
# Shared secret between backend and AI service. Must match on both sides.
INTERNAL_API_TOKEN=replace_with_random_32_char_token

# Anthropic Claude API key — enables LLM chat. Without it the service falls back
# to the keyword/fuzzy knowledge base. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Override default model if needed (default: claude-haiku-4-5-20251001)
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# JWT_EXPIRATION=86400000          # access token TTL in ms  (default: 24 h)
# SWAGGER_ENABLED=false            # expose /swagger-ui in prod? (default: false)
# UPLOAD_DIR=/app/uploads          # absolute path inside backend container
# TRUSTED_PROXY_IP=                # reverse-proxy container IP for X-Forwarded-For
